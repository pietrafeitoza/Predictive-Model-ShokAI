{
  "name": "@shokai/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Runtime-validated data contracts shared by the ShokAI model, backend, and frontend",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm test && npm run typecheck && npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
