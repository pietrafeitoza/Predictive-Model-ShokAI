# Used by Supabase migrations and the backend-only prediction importer.
# Copy this file to .env and never commit the resulting file.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
# Optional: session pooler host (e.g. aws-0-us-east-1.pooler.supabase.com). When set,
# migrations connect directly to the database instead of running `supabase link`.
SUPABASE_DB_POOLER_HOST=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
RANDOM_FOREST_PREDICTIONS_PATH=
RANDOM_FOREST_MODEL_BUNDLE_PATH=
PYTHON_BIN=python3
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173
DASHBOARD_DATA_SOURCE=mock
SUPABASE_PUBLISHABLE_KEY=
VITE_API_URL=http://localhost:3001
VITE_DASHBOARD_DATA_SOURCE=mock
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
